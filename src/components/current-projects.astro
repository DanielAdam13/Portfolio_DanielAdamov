---
import ProjectCard from './project-card.astro';
import projectsData from '../data/current-projects.json';
---

<section id="current-projects" class="section-container overflow-hidden pb-2 md:pb-4">
  <div class="container mx-auto">
    <div class="mb-16 current-project-header">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-maintext mb-2 flex items-center gap-4">
          <span class="text-accent">/</span> Currently Working on
        </h2>
      <p class="text-subtext font-body text-sm max-w-md">
        Side projects, game jams, and experiments still worth showing if interested:
      </p>
    </div>

    <div class="flex flex-wrap justify-center gap-8">
      {projectsData.map((project) => (
      <div class="w-full md:w-[calc(50%-1rem)] lg:w-[calc(33.333%-1.334rem)]">
        <ProjectCard project={project} />
      </div>
      ))}
    </div>
  </div>
</section>


<style>
  .current-project-header {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .current-project-header.reveal {
    opacity: 1 !important;
    transform: translateY(0) scale(1);
  }
</style>

<script>
  const initCurrentProjectReveal = () => {
    const header = document.querySelector('.current-project-header');
    const cards = document.querySelectorAll('#current-projects .project-card');
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const target = entry.target as HTMLElement;
          
          if (target.classList.contains('current-project-header')) {
            target.classList.add('reveal');
            observer.unobserve(target);
          } 
          else if (target.classList.contains('project-card')) {
            const index = Array.from(cards).indexOf(target);
            setTimeout(() => {
              target.classList.add('reveal');
            }, (index % 3) * 150);
            observer.unobserve(target);
          }
        }
      });
    }, { 
      threshold: 0.15, 
      rootMargin: '0px 0px -10px 0px' 
    });

    if (header) observer.observe(header);
    cards.forEach(card => observer.observe(card));
  };

  window.addEventListener('load', initCurrentProjectReveal);
  document.addEventListener('astro:after-swap', initCurrentProjectReveal);
</script>
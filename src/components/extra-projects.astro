---
import ProjectCard from './project-card.astro';
import projectsData from '../data/extra-projects.json';
---

<section id="extra-projects" class="section-container overflow-hidden">
  <div class="container mx-auto">
    <div class="mb-16 extra-project-header">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-maintext mb-2 flex items-center gap-4">
          <span class="text-accent">/</span> Extra Projects
        </h2>
      <p class="text-subtext font-body text-sm max-w-md">
        Side projects, game jams, and experiments outside my main portfolio.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projectsData.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </div>
</section>


<style>
  .extra-project-header {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .extra-project-header.reveal {
    opacity: 1 !important;
    transform: translateY(0) scale(1);
  }
</style>

<script>
  const initExtraProjectReveal = () => {
    const header = document.querySelector('.extra-project-header');
    const cards = document.querySelectorAll('#extra-projects .project-card');
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const target = entry.target as HTMLElement;
          
          if (target.classList.contains('extra-project-header')) {
            target.classList.add('reveal');
            observer.unobserve(target);
          } 
          else if (target.classList.contains('project-card')) {
            const index = Array.from(cards).indexOf(target);
            setTimeout(() => {
              target.classList.add('reveal');
            }, (index % 3) * 150);
            observer.unobserve(target);
          }
        }
      });
    }, { 
      threshold: 0.15, 
      rootMargin: '0px 0px -10px 0px' 
    });

    if (header) observer.observe(header);
    cards.forEach(card => observer.observe(card));
  };

  window.addEventListener('load', initExtraProjectReveal);
  document.addEventListener('astro:after-swap', initExtraProjectReveal);
</script>